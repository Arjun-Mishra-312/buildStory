{
  "name": "buildstory",
  "version": "0.1.0",
  "private": true,
  "description": "Closed Buildstory web app. The report engine lives in the public buildstory-scan repository.",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:buildstory": "npm --prefix apps/buildstory-web run dev",
    "build:buildstory": "npm --prefix apps/buildstory-web run build",
    "test:buildstory": "npm --prefix apps/buildstory-web test",
    "verify:buildstory": "npm --prefix apps/buildstory-web run verify",
    "verify:product": "npm run verify:buildstory"
  }
}
