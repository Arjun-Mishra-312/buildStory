{
  "name": "buildstory-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "prebuild": "npm run generate:snapshot-validator && npm run generate:narrative-validator",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "check:production-config": "tsx scripts/check-production-config.ts",
    "prepare:deploy-config": "tsx scripts/prepare-deploy-config.ts",
    "migrate:d1": "tsx scripts/migrate-d1.ts",
    "deploy:preflight": "npm run check:production-config && npm run build && npm run prepare:deploy-config && wrangler deploy --dry-run -c dist/server/wrangler.json",
    "deploy": "wrangler deploy -c dist/server/wrangler.json",
    "build:production": "npm run check:production-config && npm run build",
    "generate:snapshot-validator": "node scripts/generate-snapshot-validator.mjs",
    "generate:narrative-validator": "node scripts/generate-narrative-validator.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && tsx --test tests/*.test.ts",
    "smoke:d1": "node tests/d1-runtime-smoke.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "verify": "npm run lint && npm run typecheck && npm test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260804.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "undici": "7.29.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
