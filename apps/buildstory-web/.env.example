# Local development only. Generate a real value with: npx auth secret
AUTH_SECRET=

# Optional locally; required together in production.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: enables "Sign in with GitHub" alongside Google. Also optional in
# production, but must be set as a pair - one without the other is a config error.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Explicit local-only creator identity. Ignored whenever NODE_ENV=production.
BUILDSTORY_DEV_AUTH_BYPASS=false

# The scanner API is off unless explicitly true and is always off in production.
BUILDSTORY_LOCAL_API_ENABLED=true

# Development uses disposable process memory. Set d1 only for local D1 testing.
BUILDSTORY_STORE=memory

BUILDSTORY_PUBLIC_ORIGIN=http://localhost:3000
BUILDSTORY_ALLOWED_HOSTS=localhost,127.0.0.1,::1
BUILDSTORY_LOG_LEVEL=info
# Local Ollama is supported in development without an API key. Set the model
# to auto so the portal detects installed models and prefers gemma4:12b.
BUILDSTORY_OPENROUTER_API_KEY=
BUILDSTORY_CLOUD_PROVIDER=openrouter
BUILDSTORY_LLM_BASE_URL=https://openrouter.ai/api/v1
BUILDSTORY_LLM_MODEL=deepseek/deepseek-v4-flash
BUILDSTORY_ENABLE_HOSTED_OPENAI=false
BUILDSTORY_LAUNCH_PRO_FOR_ALL=true
# Example local values:
# BUILDSTORY_LLM_BASE_URL=http://127.0.0.1:11434/v1
# BUILDSTORY_LLM_MODEL=auto

# Bearer secret for POST /api/internal/leaderboards/recompute. Only needed
# for the external-scheduler fallback (e.g. a GitHub Actions cron job) until
# a real Cloudflare Cron Trigger is deployed. Leave unset to disable the route.
BUILDSTORY_CRON_SECRET=
