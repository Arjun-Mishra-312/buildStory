# Names only: store real secret values in the Cloudflare Worker secret store, never this file.
AUTH_SECRET=<generate-at-least-32-random-characters>
AUTH_GOOGLE_ID=<google-oauth-client-id>
AUTH_GOOGLE_SECRET=<google-oauth-client-secret>

# Optional: set both to enable "Sign in with GitHub" alongside Google.
AUTH_GITHUB_ID=<github-oauth-client-id>
AUTH_GITHUB_SECRET=<github-oauth-client-secret>

BUILDSTORY_DEV_AUTH_BYPASS=false
BUILDSTORY_LOCAL_API_ENABLED=false
BUILDSTORY_STORE=d1
BUILDSTORY_PUBLIC_ORIGIN=https://buildstory.example.com
BUILDSTORY_ALLOWED_HOSTS=buildstory.example.com
BUILDSTORY_LOG_LEVEL=info
BUILDSTORY_OPENROUTER_API_KEY=<hosted-secret>
BUILDSTORY_CLOUD_PROVIDER=openrouter
BUILDSTORY_LLM_BASE_URL=https://openrouter.ai/api/v1
BUILDSTORY_LLM_MODEL=deepseek/deepseek-v4-flash
BUILDSTORY_ENABLE_HOSTED_OPENAI=false
BUILDSTORY_LAUNCH_PRO_FOR_ALL=true
# Optional. ISO 8601 timestamp - once passed, the launch promotion above
# stops on its own, no redeploy needed. Leave unset to run indefinitely.
BUILDSTORY_LAUNCH_PRO_PROMOTION_ENDS_AT=

# Store the real value as a hosted secret, never here. Only needed for the
# external-scheduler fallback until a real Cloudflare Cron Trigger is deployed.
BUILDSTORY_CRON_SECRET=<generate-at-least-32-random-characters>

# Store the real value as a hosted secret, never here. Bootstraps the first
# admin - see docs/production-runbook.md.
BUILDSTORY_ADMIN_SECRET=<generate-at-least-32-random-characters>

# Store the real value as a hosted secret, never here. Required for report
# cover/screenshot uploads to work at all - see docs/production-runbook.md.
BUILDSTORY_MODERATION_API_KEY=<openai-api-key>

# Stripe billing for Pro. Names only - store real values as hosted secrets
# (wrangler secret put), never in this file. See docs/production-runbook.md
# for the one-time Stripe Dashboard setup this depends on.
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>
STRIPE_PRICE_ID_MONTHLY=<stripe-price-id-monthly>
STRIPE_PRICE_ID_ANNUAL=<stripe-price-id-annual>
