{
  // Deploy-time config for `wrangler deploy` and `wrangler d1 execute --remote`
  // against the real Buildstory Cloudflare account.
  // Contains real, live resource IDs (see provenance below) - NOT a template.
  //
  // The filename is load-bearing in BOTH directions - it must not be
  // `wrangler.jsonc`, and it must end in `.jsonc`:
  //
  //   - Not `wrangler.jsonc`: confirmed 2026-08-04 that `vinext dev`
  //     auto-discovers a file literally named wrangler.jsonc in this directory
  //     regardless of whether vite.config.ts references it, and MERGES it with
  //     the inline local-dev config - which then declares
  //     `nodejs_compat` twice and crashes Miniflare outright ("Compatibility
  //     flag specified multiple times: nodejs_compat").
  //
  //   - Must end in `.jsonc`: this file was previously named
  //     `wrangler.jsonc.future`, and wrangler picks its parser by extension.
  //     It silently declined to load a `.future` file, so every
  //     `-c wrangler.jsonc.future` was a NO-OP - the command ran with no
  //     config at all. Confirmed 2026-08-07: `wrangler secret list -c
  //     wrangler.jsonc.future` failed with "Required Worker name missing"
  //     even though `name` is set right below, and the identical file copied
  //     to a `.jsonc` extension resolved the name immediately. Anything that
  //     appeared to work under the old name (e.g. `d1 execute buildstory-d1`)
  //     did so only because it resolves resources by name through the API.
  //
  // `wrangler.deploy.jsonc` satisfies both: wrangler parses it, and vinext
  // does not auto-discover it. Pass `--config wrangler.deploy.jsonc`
  // explicitly on every wrangler command that needs this file.
  //
  // account_id and the D1 database were provisioned 2026-08-04:
  //   wrangler d1 create buildstory-d1
  //     -> database_id 055b1689-e3e4-4b75-8077-331c54266920
  //
  // Live schema re-verified 2026-08-07 (the earlier "5 tables through 0001"
  // note here was stale): 16 buildstory_* tables are present, matching
  // migrations 0000-0004 exactly - 3 from 0000, 2 from 0001, 3 from 0002,
  // 6 from 0003, 2 from 0004. Migration 0005 has NOT been applied
  // (buildstory_reports.publication_path is absent), nor has 0006
  // (buildstory_content_report_audit is absent).
  //
  // These were all applied by hand with `wrangler d1 execute --file=...`
  // before scripts/migrate-d1.ts existed, so there is no
  // buildstory_migrations ledger yet. The first migrate-d1.ts run must pass
  // `--baseline 0004_damp_ezekiel` to seed the ledger correctly; naming an
  // earlier tag makes it re-apply 0002+ and fail on "table already exists".
  //
  // The MEDIA bucket was provisioned 2026-08-07:
  //   wrangler r2 bucket create buildstory-media
  //     -> 'buildstory-media', Standard storage class
  // Wrangler's own output suggests the binding name `buildstory_media`; ignore
  // it. db/r2.ts resolves `env.MEDIA`, so the binding must stay MEDIA.
  //
  // Remaining before this file drives an actual `wrangler deploy`:
  //   - Explicit user/release approval before the first real `wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buildstory-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "account_id": "bfa5ce4b5d65e18a3d1cdb834183f388",

  // Non-secret runtime configuration. worker/index.ts reads
  // env.BUILDSTORY_ALLOWED_HOSTS on every request and returns 503
  // host_allowlist_unconfigured when it is empty, so without this block the
  // deployment answers nothing. lib/config/runtime.ts validates the same names
  // at build time via check:production-config.
  //
  // Secrets are deliberately absent: AUTH_SECRET, AUTH_GOOGLE_ID,
  // AUTH_GOOGLE_SECRET (and the optional AUTH_GITHUB_* pair) are set with
  // `wrangler secret put ... -c wrangler.deploy.jsonc` and must never appear
  // here - this file is committed.
  //
  // BUILDSTORY_LLM_BASE_URL/MODEL are the non-secret half of the subsidized
  // Cloud narrative path (see docs/production-runbook.md's "Enable Cloud AI"
  // step). The secret half, BUILDSTORY_LLM_API_KEY, is set separately with
  // `wrangler secret put`. Until that secret is set,
  // narrativeProviderConfigured("cloud") is false and the Cloud option stays
  // hidden in the dashboard - having the base URL/model here with no key set
  // is a safe, inert state, not a partial enablement.
  "vars": {
    "BUILDSTORY_STORE": "d1",
    "BUILDSTORY_DEV_AUTH_BYPASS": "false",
    "BUILDSTORY_LOCAL_API_ENABLED": "false",
    "BUILDSTORY_PUBLIC_ORIGIN": "https://buildstory.dev",
    "BUILDSTORY_ALLOWED_HOSTS": "buildstory.dev",
    "BUILDSTORY_LOG_LEVEL": "info",
    "BUILDSTORY_LLM_BASE_URL": "https://api.openai.com/v1",
    "BUILDSTORY_LLM_MODEL": "gpt-5.6-luna"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buildstory-d1",
      "database_id": "055b1689-e3e4-4b75-8077-331c54266920"
    }
  ],

  // Single source of truth for the deployed hostname. prepare-deploy-config.ts
  // copies this verbatim and cross-checks it against vars.BUILDSTORY_PUBLIC_ORIGIN,
  // so the route, the origin the CLI pins, and the host allowlist cannot drift.
  "routes": [{ "pattern": "buildstory.dev/*", "zone_name": "buildstory.dev" }],

  // buildstory.dev is the only hostname this deployment answers on. A
  // workers.dev URL would be a second public origin that worker/index.ts's
  // allowlist rejects with 421 for everything except /api/health and
  // /api/ready - not a breach, but a surface with no purpose. preview_urls is
  // pinned too because wrangler turns it on by default whenever workers_dev is
  // enabled, so leaving it unset makes the guarantee depend on a default.
  "workers_dev": false,
  "preview_urls": false,

  "triggers": {
    "crons": ["0 * * * *", "*/5 * * * *"]
  },

  // --- Phase 1: snapshot blobs out of D1 -----------------------------------
  // "r2_buckets": [
  //   { "binding": "SNAPSHOTS", "bucket_name": "buildstory-snapshots" }
  // ],

  // --- Phase 2: creator-uploaded artifact media (cover/screenshots) -------
  // Live. db/r2.ts throws MediaStorageUnavailableError without this binding,
  // which would break report cover/screenshot upload and leave R2 objects
  // orphaned on account deletion (lib/account/d1-store.ts swallows that error).
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "buildstory-media" }
  ],


  // --- Phase 4: per-endpoint mutation rate limiting ------------------------
  // "ratelimits": [
  //   {
  //     "name": "MUTATION_RATE_LIMITER",
  //     "namespace_id": "1001",
  //     "simple": { "limit": 30, "period": 60 }
  //   }
  // ]
}
